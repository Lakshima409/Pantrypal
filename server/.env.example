 # PantryPal server — copy to .env and fill in
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MySQL — matches server/config/db.js defaults
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=recipe_db

# Auth — REQUIRED in production (fallback "secret" is dev-only)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Flask AI microservices (Phase B — fallbacks apply when offline)
AI_RECOMMENDER_URL=http://localhost:5001
AI_PLANNER_URL=http://localhost:5002

# Optional password-reset mailer (utils/email.js skips sending when unset)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=PantryPal <no-reply@pantrypal.local>
FRONTEND_URL=http://localhost:5173
